# Environment Variables for InnSight Backend

# Server Configuration
NODE_ENV=production
PORT=8080

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here

# Database (PostgreSQL - REQUIRED)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Public Portal Configuration
PUBLIC_PORTAL_BASE_URL=http://67.211.210.8:3061

# CORS Configuration (optional)
ALLOWED_ORIGINS=http://67.211.210.8:3061

# One-time superadmin bootstrap — POST /api/auth/create-admin only works when this
# is 'true' AND no iitech_admin exists yet. Leave unset/false in production.
ALLOW_ADMIN_BOOTSTRAP=false

# Payment gateways (optional — per-tenant overrides live in tenant.paymentSettings)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# Flutterwave webhook verification uses the secret hash from the Flutterwave
# dashboard webhook settings (compared literally against the verif-hash header).
# FLUTTERWAVE_SECRET_HASH=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLIC_KEY=
# Monnify (Nigerian gateway). Base URL defaults to sandbox; set
# https://api.monnify.com for live transactions.
# MONNIFY_API_KEY=
# MONNIFY_SECRET_KEY=
# MONNIFY_CONTRACT_CODE=
# MONNIFY_BASE_URL=https://api.monnify.com

# Outbound email (SMTP). Required for reservation emails + alert delivery.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Public API base URL used for email tracking-pixel URLs. Defaults to
# PUBLIC_PORTAL_BASE_URL when unset.
# PUBLIC_API_BASE_URL=http://67.211.210.8:3061

# External analytics sink — tenant-creation metrics are POSTed here when set
# (e.g. Segment/Datadog webhook intake).
# ANALYTICS_SINK_URL=
# ANALYTICS_SINK_TOKEN=

# Backup storage + retention
BACKUP_DIR=/backups
# Days to keep manual backups; scheduled backups use their schedule's
# retentionDays instead.
BACKUP_RETENTION_DAYS=30

# Optional: File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
