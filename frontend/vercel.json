{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://67.211.210.8:3061/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://67.211.210.8:3061/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
